# CityPulse Environment Variables Template
# All external API keys are optional. If keys are missing, the app automatically engages offline fallback data.

# Supabase Free Tier Credentials (Optional for cloud reporting database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini API Key (Optional for cloud NLP report classification)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Default Fallback City Configuration
VITE_DEFAULT_CITY=Pune
VITE_DEFAULT_LAT=18.5204
VITE_DEFAULT_LNG=73.8567
